# Copy this file to backend/.env and fill in real values. Never commit .env.

# Gnani AI (STT: Prisma v3.0, TTS: Timbre) — used from Phase 2
GNANI_API_KEY=

# OpenAI-compatible LLM for the reasoning step — used from Phase 4
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
# Optional: thinking effort sent as reasoning_effort (Gemini 3.x Flash: low / medium / high). Empty = provider default.
# Note: gemini-3.8-flash (and 3.7, which routes to it) hung with no reply for this project in Nov 2026; 3.6 answers in ~3 s.
LLM_REASONING_EFFORT=low

# Optional: full path to ffmpeg.exe if it is not found automatically (PATH, registry PATH, winget folder)
FFMPEG_PATH=

# Gnani Timbre voice (timbre-v2.5, hi-IN). Urmila = female Hindi voice for formal announcements.
TTS_VOICE=Urmila
