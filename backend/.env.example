# Copy this file to backend/.env and fill in real values. Never commit .env.

# Gnani AI (STT: Prisma v3.0, TTS: Timbre) — used from Phase 2
GNANI_API_KEY=vach_1ytE2CY5X2Dz9VF0OCKNaoLEMTTbgCU22naT3EzsEZ7bT9sPv3VSHlkyvlm4BYzOl28yvzLTUJYJ4xcfiXWvAKuaThWelFuY_22d4c7f65ca5b81aa4aa2b7b1536b2d8

# OpenAI-compatible LLM for the reasoning step — used from Phase 4
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=your_gcp_api_key_here
# Optional: thinking effort sent as reasoning_effort (Gemini 3.x Flash: low / medium / high). Empty = provider default.
# Free tier (AI Studio, Nov 2026): gemini-3.1-flash-lite 15 RPM / 500 RPD (primary); gemini-3.6-flash 5 RPM / 20 RPD (fallback). gemini-3.8-flash hung for this project.
LLM_REASONING_EFFORT=low

# Optional: full path to ffmpeg.exe if it is not found automatically (PATH, registry PATH, winget folder)
FFMPEG_PATH=

# Gnani Timbre voice (timbre-v2.5, hi-IN). Urmila = female Hindi voice for formal announcements.
TTS_MODEL=timbre-v2.5
TTS_VOICE=Urmila

# Dev only: set to true to enable the "Reset demo" button (wipes all incidents, restores seed data).
ALLOW_DEMO_RESET=false

# Tried once if LLM_MODEL is still rate-limited (HTTP 429) after one retry.
LLM_FALLBACK_MODEL=gemini-3.6-flash
# Max LLM requests per minute this app sends; extra requests queue briefly instead of bursting.
LLM_MAX_RPM=12
