# Build context for the BACKEND image is the repo root (it needs backend/ and data/).
# Allow-list: send only what the Dockerfile copies, never secrets or local state.
*
!backend/app
!backend/requirements.txt
!backend/requirements-lock.txt
!data

# Never, even inside allowed folders:
**/.env
**/.env.*
**/*.db
**/__pycache__
**/cache
**/node_modules
**/.venv
**/.next
